# NestJS API origin. Eve never opens Telegram or SQLite itself.
EVE_NEST_URL=http://127.0.0.1:4001
# Must match EVE_TOKEN in apps/api/.env. Sent as x-eve-token on every call.
EVE_TOKEN=
# The only supported persona model. Keep all three EVE_LLM_* values below so
# the persona goes through the OpenAI-compatible provider.
EVE_MODEL=deepseek-v4.1-flash
# Fallback credential for the AI Gateway, used only when EVE_LLM_* is unset.
AI_GATEWAY_API_KEY=
# OpenAI-compatible provider for the persona. When all three are set, they
# take precedence over EVE_MODEL. For local dev reuse the values from
# apps/api/.env (AI_BASE_URL/AI_MODEL/AI_API_KEY).
EVE_LLM_BASE_URL=
EVE_LLM_API_KEY=
EVE_LLM_MODEL=deepseek-v4.1-flash
# Optional JSON headers for the OpenAI-compatible provider (e.g. OpenCode Go
# needs x-opencode-session). Falls back to AI_EXTRA_HEADERS when omitted.
EVE_LLM_HEADERS=
# Delayed replies are durable: the channel posts to Nest's action queue and
# Nest calls back at `dueAt`. There is no in-process timer and no local cap.

# Eve dev/start port is fixed by apps/eve/package.json (4020).
# app/api/.env.example must point at http://127.0.0.1:4020/eve/v1/nest/events
