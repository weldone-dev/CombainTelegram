# Telegram API identity
# official (default): use opentele2's bundled Telegram Desktop / Android profiles.
#   WARNING: this violates Telegram API ToS 2.1 (you must use your own api_id).
# custom: use your own credentials from https://my.telegram.org.
TELEGRAM_API_MODE=official

# Required only when TELEGRAM_API_MODE=custom.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Device fields for TELEGRAM_API_MODE=custom (ignored in official mode).
TELEGRAM_DEVICE_MODEL=Desktop
TELEGRAM_SYSTEM_VERSION=Linux x86_64
TELEGRAM_APP_VERSION=1.0.0
TELEGRAM_LANG_CODE=en
TELEGRAM_LANG_PACK=

# Default client profile: desktop | mobile | android-x | ios | macos | web-a | web-k | webogram
TELEGRAM_DEFAULT_PROFILE=desktop

# 32-byte AES-256 master key, base64. Generate with: openssl rand -base64 32
# Required in production. Development falls back to a deterministic key with a warning.
TELEGRAM_SESSION_MASTER_KEY=

# Temp dir for tdata archives/extraction (defaults to <os tmp>/combain-telegram).
TELEGRAM_TMP_DIR=

# Single-user mode: every request runs as this local user (created on demand).
# There is no local registration or login.
DEFAULT_USER_ID=local

# Web Push (browser notifications). Generate once with:
#   bunx web-push generate-vapid-keys
# Without both keys the API boots, logs a warning and /push/* answers 503.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address sent with each push (defaults to mailto:admin@localhost).
VAPID_SUBJECT=

# Comma-separated dashboard origins allowed to call the API (CORS).
# In development any localhost/127.0.0.1 port is allowed automatically.
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000

# Limits
MAX_ACCOUNTS_PER_USER=25
MAX_SESSIONS_PER_ACCOUNT=10

PORT=3001

# Telegram engine for accounts that have a native TDLib session.
# auto (default): TDLib when the account has one, mtcute otherwise.
# tdlib: force TDLib (accounts without a TDLib session fall back to mtcute).
# mtcute: never use TDLib.
TELEGRAM_ENGINE=auto

# Where TDLib keeps its encrypted databases and files, one folder per session.
# Defaults to $XDG_DATA_HOME/combain-telegram/tdlib (or ~/.local/share/...).
TDLIB_DATA_DIR=

# --- AI agent, souls and MCP -------------------------------------------------
# Any OpenAI-compatible endpoint works (DeepSeek, OpenRouter, OpenCode Zen,
# Ollama, ...). The dashboard (AI → Настройки) can override these values and
# store the key encrypted in the database.
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_FAST_MODEL=deepseek-chat
# Reasoning effort for models that support it: off | low | medium | high
AI_REASONING_EFFORT=low
AI_API_KEY_SOURCE=
AI_EXTRA_HEADERS=
AI_API_KEY=

# Optional fixed MCP bearer token. Empty = a random token is generated on the
# first boot and stored encrypted; rotate/show it in AI → Настройки → MCP.
MCP_TOKEN=

# --- Eve engine (local girl-agent style persona loop) -----------------------
# Shared secret for /internal/eve/*. Empty = the whole Eve surface is disabled
# with 503. Keep it identical in apps/eve/.env.local.
EVE_TOKEN=
# Dry run: the persona runs a full turn but no outbound action reaches
# Telegram (no message, reaction, typing, read or presence). Only an explicit
# true/1/yes/on enables it; the API logs a loud warning at startup. Empty or
# EVE_DRY_RUN_CHATS/EVE_DRY_RUN_ACCOUNTS narrow it to specific chats/accounts.
EVE_DRY_RUN=false
EVE_DRY_RUN_CHATS=
EVE_DRY_RUN_ACCOUNTS=
# How many real-context snapshots to keep per chat (old ones are pruned).
EVE_CONTEXT_SNAPSHOT_KEEP=50
# Where the Eve process calls back. Only used by apps/eve.
EVE_NEST_URL=http://127.0.0.1:4001
# Nest pushes allowed Eve events here. Empty = only the durable cursor endpoint.
EVE_WEBHOOK_URL=http://127.0.0.1:4020/eve/v1/nest/events
# Optional explicit proactive endpoint; empty disables the proactive tick.
EVE_PROACTIVE_URL=
# Deferred turns (durable delayed replies). Derived from EVE_WEBHOOK_URL when
# empty; set to an empty value to disable deferred turns entirely.
EVE_TURN_URL=

# Optional Bot API base for a local fake/proxy (defaults to https://api.telegram.org).
TELEGRAM_BOT_API_BASE=
