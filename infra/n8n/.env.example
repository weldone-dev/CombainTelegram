# n8n + Postgres environment for infra/n8n/docker-compose.yml
#
#   cp .env.example .env
#   ... fill in the secrets marked CHANGE_ME below ...
#   docker compose up -d
#
# This file is committed. The real .env is git-ignored and must be backed up
# together with ./data - it holds the key that decrypts stored credentials.

# ---------------------------------------------------------------------------
# Postgres (internal database, never published outside the compose network)
# ---------------------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_DB=n8n
# Generate: openssl rand -base64 24
# Allowed characters: letters, digits and - _ . only (goes into a connection URI).
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Generate exactly once, before the first start:
#
#     openssl rand -hex 32
#
# This key encrypts every credential n8n stores. It never changes for the life
# of the instance: if you lose it or regenerate it, saved credentials cannot be
# decrypted anymore (you would have to re-enter logins/API keys by hand).
# Never commit the real value; always keep it in your backup.
N8N_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------
# Address the browser uses to reach n8n: the host's LAN IP or DNS name.
# For this box: 192.168.1.88
N8N_HOST=192.168.1.88
# Must stay 5678 (published port in docker-compose.yml).
N8N_PORT=5678
# http on the LAN; https behind a TLS proxy.
N8N_PROTOCOL=http
# Base URL n8n puts into webhook URLs. Trailing slash matters.
WEBHOOK_URL=http://192.168.1.88:5678/

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# false only while serving plain HTTP on the LAN.
# Behind TLS (reverse proxy) set to true.
N8N_SECURE_COOKIE=false

# 1 if n8n is reached through the existing reverse proxy (single hop),
# 0 for direct LAN access.
N8N_PROXY_HOPS=0

N8N_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# llm-proxy -> OpenCode Go (n8n's built-in Assistant)
# ---------------------------------------------------------------------------
# OpenCode Go (https://opencode.ai/inference/go/openai/v1) rejects every call
# that lacks a stable `x-opencode-session` header, and n8n's Assistant model
# dialog has no field for custom headers. The small `llm-proxy` service
# (./llm-proxy, host port 4100) forwards OpenAI requests and injects both the
# session header and the real key.
#
# Where the key comes from: the `opencode` CLI login, stored in
#   ~/.local/share/opencode/opencode.db -> table `credential`,
#   integration_id = 'opencode', JSON field "access" (an `st_...` token).
# That is a short-lived OAuth access token (the one from 2026-11-25 expires
# 2026-11-28) which the CLI refreshes in place. So the proxy reads it LIVE
# from the DB (mounted read-only below, re-read every 60 s): re-login in the
# CLI and the proxy picks up the new token by itself, no restart.
# OPENCODE_API_KEY is only the FALLBACK used when that DB is not mounted or
# cannot be read.
OPENCODE_API_KEY=CHANGE_ME_opencode_go_token
# Upstream base URL; the proxy appends /chat/completions, /models, ...
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Sent as x-opencode-session. Any stable id works; keep it unique per client.
OPENCODE_SESSION=combain-n8n
# Host path to the opencode CLI data directory (the one holding opencode.db),
# bind-mounted read-only into the llm-proxy container as /data/opencode. The
# proxy re-reads the token from it every 60 s, so a CLI re-login needs no
# restart. Point it at YOUR user's directory; on another machine the home
# differs. The mount is optional - without it (or with a wrong path) the proxy
# falls back to OPENCODE_API_KEY above.
# Note: the whole directory is mounted, not only the .db file, because SQLite
# needs the -shm/-wal siblings while the CLI keeps the database open.
OPENCODE_DB_DIR=/home/roman/.local/share/opencode
#
# In n8n: Settings -> Assistant (model dialog) -> OpenAI-compatible endpoint.
# IMPORTANT: the Assistant's model test and chat run INSIDE the n8n container,
# so the URL must be the compose service name - 127.0.0.1 there is the n8n
# container itself and the host LAN IP is not reachable from it.
#   Base URL  http://llm-proxy:4000/v1
#   API key   local        <- ANY placeholder; the proxy ignores it and uses
#                            the live token above, so the real key never
#                            reaches the n8n UI, workflows or its database.
#   Model     deepseek-v4.1-flash
#
# From this host or a browser (debugging/curl only): http://127.0.0.1:4100/v1.
# The published port 4100 is not used by the Assistant itself.

# ---------------------------------------------------------------------------
# SearXNG - web search backend for the Assistant
# ---------------------------------------------------------------------------
# n8n's Assistant needs a search API for its web-search tool. ./searxng/ holds
# a self-hosted SearXNG (compose service `searxng`, loopback port 8081).
# Flask secret key for that container; it overrides the placeholder in
# searxng/settings.yml. Generate: openssl rand -hex 32
# Rotating it only invalidates SearXNG's own session cookies - no data loss.
SEARXNG_SECRET=CHANGE_ME_64_hex_chars

# Where the Assistant should send search queries. This is the value to type
# into the wizard's "SearXNG URL" field; it is NOT read by n8n itself (the
# wizard saves it in n8n's instance settings), it is here as the documented
# fallback so you don't have to remember it.
# Must be the compose service name: the query runs INSIDE the n8n container,
# so 127.0.0.1 would hit n8n and the host LAN IP is not routable from there.
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# ---------------------------------------------------------------------------
# Assistant sandbox - NOT configured here
# ---------------------------------------------------------------------------
# The self-hosted sandbox service (./sandbox) has its own secrets file:
#   sandbox/.env.example  ->  sandbox/.env
# and its own compose project. Its SANDBOX_API_KEYS value is what the
# Assistant wizard asks for as the API key (service URL http://sandbox-api:8080).
# Nothing in this file is passed to the sandbox containers, and nothing in
# sandbox/.env reaches n8n.


