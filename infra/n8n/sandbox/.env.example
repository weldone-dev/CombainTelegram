# Secrets for the n8n Assistant sandbox stack (sandbox/docker-compose.yml).
#
#   cp .env.example .env
#   # generate every secret with:  openssl rand -hex 32
#   docker compose up -d
#
# This file is committed. The real .env is git-ignored.
# These values guard the runner <-> API channel and n8n -> API access. They are
# NOT related to n8n's own N8N_ENCRYPTION_KEY and never touch ~/.n8n.
#
# Nothing here is a provider/model key: the sandbox service never sees your AI
# credentials, it only runs code the Assistant generates.

# ---------------------------------------------------------------------------
# n8n -> sandbox API
# ---------------------------------------------------------------------------
# Bearer key(s) n8n presents on every request. Comma-separated list, so a new
# key can be added for rotation while the old one still works.
#
# THIS IS THE "API key" FIELD OF THE ASSISTANT WIZARD (service URL
# http://sandbox-api:8080). Generate: openssl rand -hex 32
SANDBOX_API_KEYS=change-me-api-key

# ---------------------------------------------------------------------------
# Runner registration (two names for one value - keep them identical)
# ---------------------------------------------------------------------------
# The API hands out registration to a runner that presents this token.
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-registration-token
# The runner side of the same token.
SANDBOX_RUNNER_REGISTRATION_TOKEN=change-me-registration-token

# ---------------------------------------------------------------------------
# Runner API key (two names for one value - keep them identical)
# ---------------------------------------------------------------------------
# Key the runner uses on the API, and the API's copy of it.
SANDBOX_API_RUNNER_API_KEY=change-me-runner-key
SANDBOX_RUNNER_API_KEYS=change-me-runner-key
