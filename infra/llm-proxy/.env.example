# llm-proxy environment for infra/llm-proxy/docker-compose.yml
#
# Every value is optional: the compose file carries the same defaults.
# Copy to .env only when you need to override something:
#
#   cp .env.example .env
#
# The real .env is git-ignored. It can hold a token, so never commit it.

# ---------------------------------------------------------------------------
# OpenCode Go
# ---------------------------------------------------------------------------
# OpenCode Go (https://opencode.ai/inference/go/openai/v1) rejects every call
# that lacks a stable `x-opencode-session` header. The proxy forwards OpenAI
# requests and injects both the session header and the real key.
#
# Where the key comes from: the `opencode` CLI login, stored in
#   ~/.local/share/opencode/opencode.db -> table `credential`,
#   integration_id = 'opencode', JSON field "access" (an `st_...` token).
# That is a short-lived OAuth access token which the CLI refreshes in place,
# so the proxy reads it LIVE from the DB (mounted read-only below, re-read
# every 60 s): re-login in the CLI and the proxy picks up the new token by
# itself, no restart.
# OPENCODE_API_KEY is only the FALLBACK used when that DB is not mounted or
# cannot be read. Leave empty to rely on the DB alone.
OPENCODE_API_KEY=

# Upstream base URL; the proxy appends /chat/completions, /models, ...
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Sent as x-opencode-session. Any stable id works; keep it unique per client.
# The default (combain-n8n) is kept for continuity with existing usage
# accounting - it is just an opaque string, not a service dependency.
OPENCODE_SESSION=combain-n8n

# Host path to the opencode CLI data directory (the one holding opencode.db),
# bind-mounted read-only into the container as /data/opencode. The proxy
# re-reads the token from it every 60 s. Point it at YOUR user's directory; on
# another machine the home differs. Without a valid path the proxy falls back
# to OPENCODE_API_KEY above.
# Note: the whole directory is mounted, not only the .db file, because SQLite
# needs the -shm/-wal siblings while the CLI keeps the database open.
OPENCODE_DB_DIR=/home/roman/.local/share/opencode

# ---------------------------------------------------------------------------
# Traces (opt-in; on by default in the compose file)
# ---------------------------------------------------------------------------
# Every POST with a body is appended to ./data/llm-traces/YYYY-MM-DD.jsonl
# (real message context + the accumulated answer). Traces CONTAIN CONVERSATION
# TEXT - keep that folder private and out of version control.
# Retention in days; older files are deleted on startup and once a day.
# Minimum is 1. To disable tracing entirely, uncomment the next line (an
# explicitly empty LLM_TRACE_DIR turns the feature off):
#LLM_TRACE_DIR=
LLM_TRACE_KEEP_DAYS=7
