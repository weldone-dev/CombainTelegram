generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

/// Local application user (not a Telegram account).
model User {
  id           String           @id @default(cuid())
  email        String?          @unique
  name         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  accounts     TelegramAccount[]
  authAttempts AuthAttempt[]
  tdataUploads TdataUpload[]
  proxies      Proxy[]
  pushSubscriptions PushSubscription[]
}

/// Browser Web Push subscription (one per browser/device endpoint).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// Named proxy entry. A local user keeps a reusable list; sessions point at one.
/// `secretEncrypted` holds the password (socks/http) or MTProto secret,
/// encrypted with `SessionCryptoService` (AAD `proxy:<id>`).
model Proxy {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  kind            String           @default("socks5")
  host            String
  port            Int
  username        String?
  secretEncrypted Bytes?
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        TelegramSession[]

  @@unique([userId, name])
  @@index([userId])
}

/// One attached Telegram account slot. A local user can have many.
model TelegramAccount {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tgUserId       BigInt
  phoneEncrypted Bytes?
  phoneNonce     Bytes?
  phoneTag       Bytes?
  firstName      String
  lastName       String?
  username       String?
  /// Cloud password (2FA), sealed by SessionCryptoService (AAD `cloud:<id>`).
  cloudPasswordEncrypted Bytes?
  cloudPasswordNonce     Bytes?
  cloudPasswordTag       Bytes?
  deviceProfile  String           @default("{}")
  isActive       Boolean          @default(false)
  /// Session the app uses as the account's transport (engine + routing).
  activeSessionId String?
  lastUsedAt     DateTime?
  createdAt      DateTime         @default(now())
  sessions       TelegramSession[]
  soul           Soul?
  bots           TelegramBot[]
  automations    Automation[]
  aiChatAccess   AiChatAccess[]
  aiChatBlocks   AiChatBlock[]
  aiChatSkills   AiChatSkill[]
  aiChatEvents   AiChatEvent[]
  aiSetting      AiAccountSetting?

  @@unique([userId, tgUserId])
  @@index([userId])
}

/// One Telegram auth key = one device/session. An account can have several
/// (e.g. desktop + phone) and each is a full mtcute client.
/// `engine = "tdlib"` rows hold no mtcute payload: the auth key lives in the
/// TDLib database under `tdlibPath`, sealed with `tdlibKey*`.
model TelegramSession {
  id          String          @id @default(cuid())
  accountId   String
  account     TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId    String
  label       String?
  platform    String          @default("desktop")
  profile     String          @default("TelegramDesktop")
  /// "mtcute" (string session) or "tdlib" (native TDLib database).
  engine      String          @default("mtcute")
  dcId        Int
  apiId       Int
  proxyId     String?
  proxy       Proxy?          @relation(fields: [proxyId], references: [id], onDelete: SetNull)
  keyVersion  Int             @default(1)
  cipher      Bytes?
  nonce       Bytes?
  tag         Bytes?
  dekWrapped  Bytes?
  dekNonce    Bytes?
  dekTag      Bytes?
  /// Absolute directory of the TDLib `db`/`files` folders (engine = tdlib).
  tdlibPath   String?
  /// Envelope of the TDLib `database_encryption_key`.
  tdlibKeyEncrypted Bytes?
  tdlibKeyNonce     Bytes?
  tdlibKeyTag       Bytes?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@unique([accountId, deviceId])
  @@index([accountId])
}

/// Ephemeral login attempt (phone / qr / tdata).
model AuthAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  method    String
  status    String
  payload   String   @default("{}")
  error     String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// tdata upload kept only until import or expiry.
model TdataUpload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String
  accounts  String   @default("[]")
  tempPath  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, status])
}

/// Structured application log: API calls, Telegram RPC responses, auth steps,
/// client/proxy failures. Read by the dashboard and by AI agents over REST.
model LogEntry {
  id               String   @id @default(cuid())
  level            String   @default("info")
  source           String   @default("app")
  action           String
  message          String
  status           String?
  requestId        String?
  userId           String?
  accountId        String?
  sessionId        String?
  chatId           Int?
  attemptId        String?
  durationMs       Int?
  errorCode        String?
  telegramMethod   String?
  telegramError    String?
  telegramResponse String?
  proxyId          String?
  proxyLabel       String?
  /// Snapshot of the proxy at request time (name, kind, host, port, username).
  /// Kept even after the proxy is edited or deleted.
  proxySnapshot    String?
  details          String   @default("{}")
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([accountId, createdAt])
  @@index([proxyId, createdAt])
  @@index([requestId])
}


// ---------------------------------------------------------------------------
// AI: souls, memory, skills, bots, automations, MCP settings
// ---------------------------------------------------------------------------

/// One "soul" (persona) per Telegram account. Used by the agent whenever it
/// acts on the account's behalf.
model Soul {
  id           String          @id @default(cuid())
  accountId    String          @unique
  account      TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  essence      String          @default("")
  tone         String          @default("")
  goals        String          @default("")
  boundaries   String          @default("")
  language     String          @default("ru")
  /// Extra instructions appended after the generated persona prompt.
  systemPrompt String?
  /// off | draft | auto
  mode         String          @default("off")
  /// JSON: { chatIds: number[], excludeChatIds: number[], replyDelayMs,
  ///         maxPerHour, maxPerChatPerDay, typing }
  settings     String          @default("{}")
  model        String?
  temperature  Float           @default(0.7)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  skills       SoulSkill[]
  chatAccess   AiChatAccess[]
  automations  Automation[]
}

model SoulSkill {
  soulId  String
  soul    Soul   @relation(fields: [soulId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([soulId, skillId])
}

/// Reusable instruction pack: "what to do and how" for one class of tasks.
/// Skills are attached to souls and account bots; an agent may author new
/// skills when the policy allows it.
model Skill {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String    @default("")
  instructions String
  /// JSON array of tool names. Empty = every tool the policy allows.
  tools        String    @default("[]")
  /// system | user | agent
  origin       String    @default("user")
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  souls        SoulSkill[]
  bots         BotSkill[]
}

/// Short-term memory: the recent dialogue buffer of one account+chat.
model SoulTurn {
  id        String   @id @default(cuid())
  accountId String
  chatId    BigInt
  /// user | assistant | system | tool | draft
  role      String
  content   String
  messageId BigInt?
  runId     String?
  createdAt DateTime @default(now())

  @@index([accountId, chatId, createdAt])
}

/// Long-term rolling summary of one DM (what happened, who the peer is).
model SoulSummary {
  id           String   @id @default(cuid())
  accountId    String
  chatId       BigInt
  summary      String   @default("")
  /// JSON array of facts already folded into `summary`.
  facts        String   @default("[]")
  turnsThrough DateTime?
  updatedAt    DateTime @updatedAt

  @@unique([accountId, chatId])
  @@index([accountId])
}

/// Durable facts and preferences extracted from conversations.
model SoulMemory {
  id         String    @id @default(cuid())
  accountId  String
  /// Null = account-wide fact, otherwise scoped to one DM.
  chatId     BigInt?
  /// fact | preference | event | profile
  kind       String    @default("fact")
  content    String
  importance Int       @default(1)
  source     String    @default("agent")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([accountId, chatId, createdAt])
}

/// A Telegram bot bound to the app: the shared soul-creator bot
/// (`accountId = null`, `mode = "soul-creator"`) or one assistant bot per
/// account (`mode = "assistant"`).
model TelegramBot {
  id             String          @id @default(cuid())
  accountId      String?         @unique
  account        TelegramAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  username       String?
  title          String?
  /// soul-creator | assistant
  mode           String          @default("assistant")
  enabled        Boolean         @default(true)
  tokenEncrypted  Bytes?
  tokenNonce      Bytes?
  tokenTag        Bytes?
  tokenDekWrapped Bytes?
  tokenDekNonce   Bytes?
  tokenDekTag     Bytes?
  /// JSON array of allowed Telegram user ids. Empty = any account owner.
  allowedUserIds String          @default("[]")
  lastUpdateId   BigInt          @default(0)
  lastError      String?
  lastPolledAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  skills         BotSkill[]
  turns          BotTurn[]
}

model BotSkill {
  botId   String
  bot     TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([botId, skillId])
}

/// Short-term memory of a bot conversation (the control surface).
model BotTurn {
  id        String      @id @default(cuid())
  botId     String
  bot       TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  chatId    BigInt
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([botId, chatId, createdAt])
}

/// Configurable trigger → action rule. Triggers may run on a schedule or on
/// incoming personal messages; actions either run the agent or send a message.
model Automation {
  id              String           @id @default(cuid())
  accountId       String?
  account         TelegramAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  description     String           @default("")
  enabled         Boolean          @default(true)
  /// schedule | incoming_message | manual
  triggerType     String           @default("manual")
  /// JSON trigger config
  trigger         String           @default("{}")
  /// agent | send_message | summarize
  actionType      String           @default("agent")
  /// JSON action config
  action          String           @default("{}")
  /// Chat the automation is scoped to. Null = any chat / not chat-bound.
  chatId          BigInt?
  /// Forum topic or channel-comment thread. `0` = whole chat (sentinel, see
  /// `AiChatAccess.threadId`).
  threadId        Int              @default(0)
  /// Soul that owns / created the automation, when `createdBy = "soul"`.
  soulId          String?
  soul            Soul?            @relation(fields: [soulId], references: [id], onDelete: SetNull)
  /// user | soul | assistant
  createdBy       String           @default("user")
  /// IANA timezone name (e.g. "Europe/Moscow") for schedule triggers.
  timezone        String?
  /// Set by the agent when it pauses itself; cleared on manual resume.
  selfPausedAt    DateTime?
  selfPauseReason String?
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  runCount        Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  runs            AutomationRun[]

  @@index([enabled, nextRunAt])
  @@index([accountId, chatId])
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       String     @default("running")
  input        String     @default("{}")
  output       String?
  error        String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?

  @@index([automationId, startedAt])
}

/// Singleton AI provider + permission policy. Secrets use the standard
/// envelope (`SessionCryptoService`); API keys are never returned in full.
model AiSetting {
  id                 String   @id @default("default")
  provider           String   @default("openai-compatible")
  baseUrl            String   @default("")
  model              String   @default("")
  fastModel          String   @default("")
  apiKeyEncrypted    Bytes?
  apiKeyNonce        Bytes?
  apiKeyTag          Bytes?
  apiKeyDekWrapped   Bytes?
  apiKeyDekNonce     Bytes?
  apiKeyDekTag       Bytes?
  temperature        Float    @default(0.7)
  maxSteps           Int      @default(6)
  /// Reasoning effort sent to the model: off | low | medium | high.
  reasoningEffort    String   @default("low")
  /// Speech-to-text engine: auto | openai-compatible | disabled.
  sttEngine          String   @default("auto")
  sttBaseUrl         String   @default("")
  sttModel           String?
  /// STT API key, plain string; the app seals it before returning it.
  sttApiKey          String?
  /// BCP-47 language hint for transcription; auto = provider default.
  sttLanguage        String   @default("auto")
  /// When true, send/edit/delete/react tools answer with a simulated result
  /// instead of touching Telegram. Soul autopilot is exempt (explicit opt-in).
  dryRun             Boolean  @default(true)
  /// JSON capabilities: read, send, react, edit, delete, admin, souls,
  /// skills, automations, bots, policy.
  capabilities       String   @default("{}")
  /// JSON arrays of ids/numbers; empty means "not restricted".
  allowAccountIds    String   @default("[]")
  allowChatIds       String   @default("[]")
  blockChatIds       String   @default("[]")
  /// Telegram user ids allowed to control the bots. Empty = account owners.
  ownerTgUserIds     String   @default("[]")
  mcpTokenEncrypted  Bytes?
  mcpTokenNonce      Bytes?
  mcpTokenTag        Bytes?
  mcpTokenDekWrapped Bytes?
  mcpTokenDekNonce   Bytes?
  mcpTokenDekTag     Bytes?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Per-chat permission for the AI soul: may it read / answer this chat (or one
/// forum topic of it). `enabled = false` is an explicit mute, shadowing the
/// soul's own chat selection.
model AiChatAccess {
  id        String          @id @default(cuid())
  userId    String
  accountId String
  account   TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId    BigInt
  /// Forum topic / channel-comment thread id. `0` = whole chat. Sentinel
  /// instead of NULL because SQLite treats NULLs as distinct in unique keys,
  /// which would let duplicate whole-chat rows through.
  threadId  Int             @default(0)
  /// Null = applies to any soul of the account.
  soulId    String?
  soul      Soul?           @relation(fields: [soulId], references: [id], onDelete: Cascade)
  enabled   Boolean         @default(true)
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([accountId, chatId, threadId])
  @@index([userId])
  @@index([accountId, chatId])
}

/// Blacklist for a chat / thread: a block always wins over `AiChatAccess`
/// (and over the soul's autopilot). `warnings` counts soft warnings before the
/// block; `blockedBy` records whether a human or the soul itself blocked it.
model AiChatBlock {
  id        String          @id @default(cuid())
  userId    String
  accountId String
  account   TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId    BigInt
  /// Forum topic / channel-comment thread id. `0` = whole chat (sentinel, see
  /// `AiChatAccess.threadId`).
  threadId  Int             @default(0)
  reason    String?
  warnings  Int             @default(0)
  /// user | soul
  blockedBy String          @default("user")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([accountId, chatId, threadId])
  @@index([userId])
  @@index([accountId, chatId])
}

/// Skills attached to one chat / thread, replacing the soul's default skill
/// set for that conversation. `skillSlugs` is a JSON array of `Skill.slug`.
model AiChatSkill {
  id         String          @id @default(cuid())
  accountId  String
  account    TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId     BigInt
  /// Forum topic / channel-comment thread id. `0` = whole chat (sentinel, see
  /// `AiChatAccess.threadId`).
  threadId   Int             @default(0)
  /// JSON array of skill slugs used for this chat instead of the soul's.
  skillSlugs String          @default("[]")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([accountId, chatId, threadId])
  @@index([accountId, chatId])
}

/// Audit trail of AI decisions about a chat: warnings, blocks, clears and
/// access changes. Kept append-only so the dashboard can explain a block.
model AiChatEvent {
  id        String          @id @default(cuid())
  accountId String
  account   TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId    BigInt
  /// Forum topic / channel-comment thread id. `0` = whole chat (sentinel, see
  /// `AiChatAccess.threadId`).
  threadId  Int             @default(0)
  /// warning | block | unblock | clear | access
  kind      String
  reason    String?
  warnings  Int             @default(0)
  /// user | soul | system
  actor     String          @default("user")
  createdAt DateTime        @default(now())

  @@index([accountId, chatId, createdAt])
}

/// Per-account overrides of the global AI capabilities (`AiSetting.capabilities`).
/// `permissions` is a JSON object; missing keys inherit the global policy.
model AiAccountSetting {
  id          String          @id @default(cuid())
  accountId   String          @unique
  account     TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// JSON object of per-account permission overrides.
  permissions String          @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// LLM provider configurable from the dashboard. The account may have several
/// and pick one per task; `isDefault` marks the fallback.
model AiProvider {
  id              String   @id @default(cuid())
  name            String
  /// openai-compatible | anthropic | … (whatever the adapter supports).
  kind            String   @default("openai-compatible")
  /// Known preset the row was created from (e.g. "opencode-go"). Null = custom.
  preset          String?
  baseUrl         String   @default("")
  /// API key, plain string in the DB; the app encrypts it at rest and never
  /// returns it in full.
  apiKey          String?
  /// JSON array of model ids offered by this provider.
  models          String   @default("[]")
  defaultModel    String?
  /// off | low | medium | high
  reasoningEffort String   @default("low")
  /// JSON: { maxPerHour?: number, maxPerDay?: number }. Limits are per
  /// provider, not per app.
  limits          String   @default("{}")
  isDefault       Boolean  @default(false)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// One agent invocation: manual chat, MCP tool call, bot message, DM
/// autopilot or automation. `trace` keeps the tool calls for debugging.
model AgentRun {
  id           String    @id @default(cuid())
  accountId    String?
  soulId       String?
  chatId       BigInt?
  /// ui | mcp | dm | bot | automation | test
  source       String
  status       String    @default("running")
  prompt       String
  output       String?
  /// Model reasoning / thinking, when the provider returns it.
  reasoning    String?
  model        String?
  steps        Int       @default(0)
  trace        String    @default("[]")
  /// JSON array of Telegram message ids the run produced (for attaching the
  /// reasoning to message bubbles in the dashboard).
  messageIds   String?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([accountId, createdAt])
  @@index([source, createdAt])
}
