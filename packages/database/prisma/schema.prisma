generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

/// Local application user (not a Telegram account).
model User {
  id                String             @id @default(cuid())
  email             String?            @unique
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          TelegramAccount[]
  authAttempts      AuthAttempt[]
  tdataUploads      TdataUpload[]
  proxies           Proxy[]
  pushSubscriptions PushSubscription[]
}

/// Browser Web Push subscription (one per browser/device endpoint).
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// Named proxy entry. A local user keeps a reusable list; sessions point at one.
/// `secretEncrypted` holds the password (socks/http) or MTProto secret,
/// encrypted with `SessionCryptoService` (AAD `proxy:<id>`).
model Proxy {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  kind            String            @default("socks5")
  host            String
  port            Int
  username        String?
  secretEncrypted Bytes?
  enabled         Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        TelegramSession[]

  @@unique([userId, name])
  @@index([userId])
}

/// One attached Telegram account slot. A local user can have many.
model TelegramAccount {
  id                     String              @id @default(cuid())
  userId                 String
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tgUserId               BigInt
  phoneEncrypted         Bytes?
  phoneNonce             Bytes?
  phoneTag               Bytes?
  firstName              String
  lastName               String?
  username               String?
  /// Cloud password (2FA), sealed by SessionCryptoService (AAD `cloud:<id>`).
  cloudPasswordEncrypted Bytes?
  cloudPasswordNonce     Bytes?
  cloudPasswordTag       Bytes?
  deviceProfile          String              @default("{}")
  isActive               Boolean             @default(false)
  /// Session the app uses as the account's transport (engine + routing).
  activeSessionId        String?
  lastUsedAt             DateTime?
  createdAt              DateTime            @default(now())
  sessions               TelegramSession[]
  /// girl-agent style personas bound to this account (new Eve engine).
  evePersonaAccounts     EvePersonaAccount[]
  eveChatBindings        EveChatBinding[]

  @@unique([userId, tgUserId])
  @@index([userId])
}

/// One Telegram auth key = one device/session. An account can have several
/// (e.g. desktop + phone) and each is a full mtcute client.
/// `engine = "tdlib"` rows hold no mtcute payload: the auth key lives in the
/// TDLib database under `tdlibPath`, sealed with `tdlibKey*`.
model TelegramSession {
  id                String          @id @default(cuid())
  accountId         String
  account           TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId          String
  label             String?
  platform          String          @default("desktop")
  profile           String          @default("TelegramDesktop")
  /// "mtcute" (string session) or "tdlib" (native TDLib database).
  engine            String          @default("mtcute")
  dcId              Int
  apiId             Int
  proxyId           String?
  proxy             Proxy?          @relation(fields: [proxyId], references: [id], onDelete: SetNull)
  keyVersion        Int             @default(1)
  cipher            Bytes?
  nonce             Bytes?
  tag               Bytes?
  dekWrapped        Bytes?
  dekNonce          Bytes?
  dekTag            Bytes?
  /// Absolute directory of the TDLib `db`/`files` folders (engine = tdlib).
  tdlibPath         String?
  /// Envelope of the TDLib `database_encryption_key`.
  tdlibKeyEncrypted Bytes?
  tdlibKeyNonce     Bytes?
  tdlibKeyTag       Bytes?
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime        @default(now())

  @@unique([accountId, deviceId])
  @@index([accountId])
}

/// Ephemeral login attempt (phone / qr / tdata).
model AuthAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  method    String
  status    String
  payload   String   @default("{}")
  error     String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// tdata upload kept only until import or expiry.
model TdataUpload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String
  accounts  String   @default("[]")
  tempPath  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, status])
}

/// Structured application log: API calls, Telegram RPC responses, auth steps,
/// client/proxy failures. Read by the dashboard and by AI agents over REST.
model LogEntry {
  id               String   @id @default(cuid())
  level            String   @default("info")
  source           String   @default("app")
  action           String
  message          String
  status           String?
  requestId        String?
  userId           String?
  accountId        String?
  sessionId        String?
  chatId           Int?
  attemptId        String?
  durationMs       Int?
  errorCode        String?
  telegramMethod   String?
  telegramError    String?
  telegramResponse String?
  proxyId          String?
  proxyLabel       String?
  /// Snapshot of the proxy at request time (name, kind, host, port, username).
  /// Kept even after the proxy is edited or deleted.
  proxySnapshot    String?
  details          String   @default("{}")
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([accountId, createdAt])
  @@index([proxyId, createdAt])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Eve (local persona engine) — the only LLM stack.
// ---------------------------------------------------------------------------

model EvePersona {
  id              String   @id @default(cuid())
  name            String
  age             Int      @default(22)
  nationality     String   @default("RU")
  timezone        String   @default("Europe/Moscow")
  stage           String   @default("tg-given-warming")
  mode            String   @default("auto")
  sleepFrom       Int      @default(23)
  sleepTo         Int      @default(8)
  nightWakeChance Float    @default(0.05)
  ignoreTendency  Int      @default(35)
  communication   String   @default("{}")
  /// Weekly busy routine as JSON (`BusySlot[]`); empty/null means no routine.
  busySchedule    String?
  vibe            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  docs          EvePersonaDoc[]
  accounts      EvePersonaAccount[]
  bindings      EveChatBinding[]
  relationships EveRelationship[]

  @@index([name])
}

/// A named document of a persona: persona/speech/boundaries/communication/...
model EvePersonaDoc {
  id        String     @id @default(cuid())
  personaId String
  persona   EvePersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  kind      String
  content   String     @default("")
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  @@unique([personaId, kind])
}

/// Bind one persona to one Telegram account (or several accounts to one persona).
model EvePersonaAccount {
  id               String          @id @default(cuid())
  personaId        String
  persona          EvePersona      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  accountId        String
  account          TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// shared = one relationship per persona+peer; isolated = per account+chat.
  relationshipMode String          @default("isolated")
  enabled          Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([personaId, accountId])
  @@index([accountId])
}

/// Explicit allowlist: a chat is answered only when this row is allowed.
model EveChatBinding {
  id        String          @id @default(cuid())
  personaId String
  persona   EvePersona      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  accountId String
  account   TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId    BigInt
  threadId  Int             @default(0)
  allowed   Boolean         @default(false)
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([personaId, accountId, chatId, threadId])
  @@index([accountId, chatId])
}

/// Relationship state for a persona and a peer scope key.
model EveRelationship {
  id         String     @id @default(cuid())
  personaId  String
  persona    EvePersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  /// shared: persona+tgUserId; isolated: persona+accountId+chatId.
  scopeKey   String
  stage      String     @default("tg-given-warming")
  interest   Int        @default(0)
  trust      Int        @default(0)
  attraction Int        @default(0)
  annoyance  Int        @default(0)
  cringe     Int        @default(0)
  notes      String     @default("")
  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())

  events   EveRelationshipEvent[]
  changes  EveRelationshipChange[]
  conflict EveConflict?

  @@unique([personaId, scopeKey])
}

model EveRelationshipEvent {
  id             String          @id @default(cuid())
  relationshipId String
  relationship   EveRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  kind           String          @default("note")
  text           String
  createdAt      DateTime        @default(now())

  @@index([relationshipId, createdAt])
}

/// One applied relationship mutation: score deltas (after clamping), a stage
/// transition and/or a conflict move. Separate from `EveRelationshipEvent`,
/// whose text rows feed memory retrieval; these rows feed the chat timeline.
model EveRelationshipChange {
  id             String          @id @default(cuid())
  relationshipId String
  relationship   EveRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  personaId      String
  accountId      String
  chatId         BigInt
  threadId       Int             @default(0)
  /// inbound | proactive | reaction | ignore
  source         String          @default("inbound")
  /// Applied score delta as JSON: `{ "interest": 2 }`.
  delta          String          @default("{}")
  before         String          @default("{}")
  after          String          @default("{}")
  stageFrom      String?
  stageTo        String?
  conflictBefore Int?
  conflictAfter  Int?
  turnKey        String?
  createdAt      DateTime        @default(now())

  @@unique([relationshipId, turnKey])
  @@index([personaId, accountId, chatId, threadId, createdAt])
}

/// Durable idempotency gate for one `turn/apply` writeback.
///
/// `EveSessionState` keeps only the last applied turn key, so a retry that
/// arrives after another turn already moved the state would otherwise count
/// the messages and write the log lines again. One row per real turn is cheap
/// and survives restarts.
model EveTurnApply {
  id        String   @id @default(cuid())
  personaId String
  accountId String
  chatId    BigInt
  threadId  Int      @default(0)
  turnKey   String
  createdAt DateTime @default(now())

  @@unique([personaId, accountId, chatId, threadId, turnKey])
  @@index([createdAt])
}

model EveConflict {
  id             String          @id @default(cuid())
  relationshipId String          @unique
  relationship   EveRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  level          Int             @default(0)
  coldUntil      DateTime?
  reason         String?
  history        String          @default("[]")
  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())

  events EveConflictEvent[]
}

model EveConflictEvent {
  id            String       @id @default(cuid())
  conflictId    String
  level         Int
  note          String       @default("")
  createdAt     DateTime     @default(now())
  eveConflict   EveConflict? @relation(fields: [eveConflictId], references: [id])
  eveConflictId String?

  @@index([conflictId, createdAt])
}

model EveAgendaItem {
  id         String   @id @default(cuid())
  personaId  String
  accountId  String
  chatId     BigInt
  about      String
  reason     String   @default("")
  kind       String   @default("proactive-life")
  state      String   @default("pending")
  importance Int      @default(1)
  pingAt     DateTime
  attempts   Int      @default(0)
  history    String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([personaId, state, pingAt])
  @@index([accountId, chatId])
}

model EveDailyLife {
  id        String   @id @default(cuid())
  personaId String
  date      String
  markdown  String   @default("")
  json      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personaId, date])
}

model EveMemoryDaily {
  id        String   @id @default(cuid())
  personaId String
  date      String
  markdown  String   @default("")
  json      String   @default("{}")
  complete  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personaId, date])
}

model EveMemoryFact {
  id             String   @id @default(cuid())
  personaId      String
  relationshipId String?
  kind           String   @default("fact")
  content        String
  importance     Int      @default(3)
  source         String   @default("agent")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([personaId, kind])
  @@index([relationshipId])
}

model EveEpisode {
  id        String   @id @default(cuid())
  personaId String
  date      String
  content   String
  createdAt DateTime @default(now())

  @@unique([personaId, date])
}

model EvePalaceDrawer {
  id        String   @id @default(cuid())
  personaId String
  drawerId  String
  wing      String
  hall      String
  room      String
  content   String
  keywords  String   @default("[]")
  salience  Int      @default(5)
  source    String   @default("interaction")
  hash      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personaId, drawerId])
  @@index([personaId, hall])
}

model EveTimeItem {
  id             String    @id @default(cuid())
  personaId      String
  relationshipId String?
  kind           String    @default("open-loop")
  content        String
  status         String    @default("open")
  dueAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([personaId, kind, status])
}

model EveCrossChatMemory {
  id        String   @id @default(cuid())
  personaId String
  peerId    String
  content   String
  createdAt DateTime @default(now())

  @@index([personaId, peerId])
}

model EveSessionLog {
  id        String   @id @default(cuid())
  personaId String
  accountId String
  chatId    BigInt
  threadId  Int      @default(0)
  day       String
  line      String
  createdAt DateTime @default(now())

  @@index([personaId, day])
  @@index([accountId, chatId, createdAt])
  @@index([personaId, accountId, chatId, threadId, createdAt])
}

model EveSticker {
  id        String   @id @default(cuid())
  personaId String
  fileId    String
  emoji     String   @default("")
  tags      String   @default("[]")
  createdAt DateTime @default(now())

  @@unique([personaId, fileId])
}

model EveProactiveState {
  id        String   @id @default(cuid())
  personaId String
  date      String
  marker    String
  createdAt DateTime @default(now())

  @@unique([personaId, date, marker])
}

model EveSessionState {
  id        String   @id @default(cuid())
  personaId String
  accountId String
  chatId    BigInt
  state     String   @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([personaId, accountId, chatId])
}

/// Durable deferred work for the Eve channel: a delayed turn or a delayed
/// Telegram action. Nest owns the clock, so an Eve restart loses nothing.
model EveDelayedAction {
  id        String    @id @default(cuid())
  personaId String
  accountId String
  chatId    BigInt
  threadId  Int       @default(0)
  /// turn | send | edit | delete | react | read
  kind      String
  /// delay | sleep | busy | offline | followup
  reason    String    @default("delay")
  /// Idempotency key of the originating event; null for ad-hoc work.
  key       String?
  payload   String    @default("{}")
  /// null = wait for a state change (asleep/busy), not for the clock.
  dueAt     DateTime?
  state     String    @default("pending")
  attempts  Int       @default(0)
  lastError String?
  firedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([personaId, key])
  @@index([state, dueAt])
  @@index([personaId, state])
  @@index([accountId, chatId])
}

/// Durable event outbox for the Eve channel. Nest writes; Eve reads/replays.
model EveEvent {
  id          String    @id @default(cuid())
  kind        String
  personaId   String?
  accountId   String?
  chatId      BigInt?
  threadId    Int       @default(0)
  payload     String    @default("{}")
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([createdAt])
  @@index([personaId, createdAt])
  @@index([deliveredAt])
}

/// What actually went to the model on one Eve turn.
///
/// The Eve process captures the final model input in an instrumentation
/// provider (exactly the instructions and messages the AI SDK received) and
/// posts it here after the turn settles. `systemJson`/`messagesJson` are JSON
/// arrays, `tokensJson` is the usage or an estimate (`meta.estimated`).
/// `turnId` is `<eveSessionId>:<turnId>` so a retried turn is idempotent even
/// after a session reset (turn ids restart at `turn_0`).
model EveContextSnapshot {
  id           String   @id @default(cuid())
  personaId    String
  accountId    String
  chatId       BigInt
  threadId     Int      @default(0)
  /// inbound | proactive | deletion | reaction | other
  kind         String   @default("other")
  model        String   @default("")
  turnId       String?
  tokensJson   String   @default("{}")
  systemJson   String   @default("[]")
  messagesJson String   @default("[]")
  metaJson     String   @default("{}")
  /// Outbound actions were suppressed for this chat while the turn ran.
  dryRun       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([personaId, accountId, chatId, turnId])
  @@index([personaId, chatId, createdAt])
  @@index([personaId, accountId, createdAt])
}

/// Durable dedupe claim for the Eve event outbox. `EveEvent.dedupeKey` is not
/// unique (legacy rows may repeat), and the in-memory claim is lost on restart,
/// so a replayed realtime update could become a second event and a second turn.
/// Pruned by age; `key` is the provider dedupe key.
model EveEventDedupe {
  key       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}
